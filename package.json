{
	"name": "@timio23/directus-operation-cryptography",
	"description": "Provides HMAC-SHA256 cryptographic functions for secure data signing, verification, and encryption within your automation pipelines.",
	"icon": "extension",
	"version": "1.0.0",
	"author": "Tim Butterfield",
	"contributors": [
		{
			"name": "Tim Butterfield",
			"email": "tim.butterfield@me.com",
			"url": "https://www.npmjs.com/~timio23"
		}
	],
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-operation",
		"hmac",
		"sha256",
		"hmac-sha256",
		"hash",
		"sha",
		"cryptography",
		"crypto"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "operation",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"source": {
			"app": "src/app.ts",
			"api": "src/api.ts"
		},
		"host": "^11.0.0",
		"sandbox": {
			"enabled": true,
      "requestedScopes": {}
		},
		"homepage": "https://github.com/timio23/directus-operation-hmac-sha256#readme",
		"repository": {
			"type": "git",
			"url": "https://github.com/timio23/directus-operation-hmac-sha256.git"
		},
		"bugs": {
			"url": "https://github.com/timio23/directus-operation-hmac-sha256/issues"
		}
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.3",
		"vue": "^3.5.34"
	}
}
